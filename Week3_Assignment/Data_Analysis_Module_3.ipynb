   "source": [
    "# ── CUSTOMERS TABLE ──\n",
    "conn.execute(\"\"\"\n",
    "    CREATE TABLE IF NOT EXISTS customers AS\n",
    "    SELECT DISTINCT\n",
    "        [Customer ID]   AS customer_id,\n",
    "        [Customer Name] AS customer_name,\n",
    "        [Segment]       AS segment,\n",
    "        [City]          AS city,\n",
    "        [State]         AS state,\n",
    "        [Region]        AS region\n",
    "    FROM superstore_raw\n",
