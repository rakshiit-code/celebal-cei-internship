   "source": [
    "### 4.2 Highest Sales Order per Customer"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "afa7d30a",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "  customer_id    customer_name        order_id  max_order_sales\n",
