   "source": [
    "## 4. Subqueries | CTE | Window Function <a id='subqueries'></a>\n",
    "\n",
    "### 4.1 Orders with Above-Average Sales\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "76ea0e82",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
