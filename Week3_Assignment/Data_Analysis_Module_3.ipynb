       "1    TC-20980     Tamara Chand  CA-2016-118689         17499.95\n",
       "2    RB-19360     Raymond Buch  CA-2017-140151         13999.96\n",
       "3    TA-21385     Tom Ashbrook  CA-2017-127180         11199.97\n",
       "4    HL-15040     Hunter Lopez  CA-2017-166709         10499.97\n",
       "5    AB-10105    Adrian Barton  CA-2016-117121          9892.74\n",
       "6    SC-20095     Sanjit Chand  CA-2014-116904          9449.95\n",
       "7    BS-11365  Christopher Con  US-2016-107440          9099.93\n",
       "8    SE-20110     Sanjit Engle  CA-2016-158841          8749.95\n",
       "9    CC-12370  Christopher Con  CA-2016-143714          8399.98"
      ]
     },
     "execution_count": 15,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "# For each customer, get the order with their highest single-order sales\n",
    "query = \"\"\"\n",
    "    SELECT o.customer_id, c.customer_name, o.order_id, ROUND(o.sales, 2) AS max_order_sales\n",
    "    FROM orders o\n",
    "    JOIN customers c ON o.customer_id = c.customer_id\n",
    "    WHERE o.sales = (\n",
    "        SELECT MAX(o2.sales)\n",
    "        FROM orders o2\n",
    "        WHERE o2.customer_id = o.customer_id\n",
    "    )\n",
    "    ORDER BY max_order_sales DESC\n",
    "    LIMIT 10\n",
    "\"\"\"\n",
    "pd.read_sql(query, conn)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "69d987ef-b823-4b28-bd1f-67139b50d2f9",
